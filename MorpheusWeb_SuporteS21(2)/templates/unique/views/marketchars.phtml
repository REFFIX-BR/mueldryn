    color: #fff;
    font-size: 14px;
    font-weight: 700;
}
.mkt-price__coin {
    display: flex;
    align-items: center;
    gap: 6px;
}
.mkt-price__coin small {
    color: rgba(255,255,255,0.45);
    font-weight: 500;
    font-size: 11px;
}
.mkt-jewels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 10px;
}
.mkt-jewels__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 36px;
}
.mkt-jewels__item img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    image-rendering: auto;
}
.mkt-jewels__item span {
    font-size: 11px;
    color: #ffb84d;
    font-weight: 700;
    margin-top: 2px;
}
.mkt-seller {
    text-align: center;
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    margin-bottom: 12px;
}
.mkt-seller strong { color: rgba(255,255,255,0.75); }

.mkt-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}
.mkt-actions .btn {
    flex: 1;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 9px 10px;
    border: none;
}
.mkt-actions .btn-info-mkt {
    background: #1e7bff;
    color: #fff;
}
.mkt-actions .btn-info-mkt:hover {
    background: #1669e0;
    color: #fff;
}
.mkt-actions .btn-buy-mkt {
    background: #22c55e;
    color: #fff;
}
.mkt-actions .btn-buy-mkt:hover {
    background: #16a34a;
    color: #fff;
}
.mkt-actions .btn-cancel-mkt {
    background: #ef4444;
    color: #fff;
}

.mkt-inv {
    margin: 0 0 12px;
    border-radius: 10px;
    background: rgba(0,0,0,0.28);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 8px;
}
.mkt-inv summary {
    cursor: pointer;
    list-style: none;
    text-align: center;
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px;
}
.mkt-inv summary::-webkit-details-marker { display: none; }
.mkt-inv[open] summary { margin-bottom: 8px; color: #ffb84d; }
.mkt-inv__scroll {
    overflow-x: auto;
    transform: scale(0.62);
    transform-origin: top center;
    height: 280px;
}

.mkt-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px 16px;
    color: rgba(255,255,255,0.55);
}

@media (max-width: 520px) {
    .mkt-grid {
        grid-template-columns: 1fr;
        max-width: 280px;
        margin: 0 auto;
    }
}
</style>

<div class="panel-heading"><i class="fa fa-shopping-cart"></i> Mercado de Personagens</div>
