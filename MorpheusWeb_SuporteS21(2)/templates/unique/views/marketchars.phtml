<style>
.mkt-wrap {
    position: relative;
    padding: 28px 8px 8px;
}
.mkt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 56px 18px;
    align-items: stretch;
}
.mkt-card {
    --accent: #5ec8ff;
    --glow: rgba(94, 200, 255, 0.45);
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 92px;
    padding: 78px 14px 14px;
    border-radius: 16px;
    background:
        radial-gradient(ellipse at 50% 0%, var(--glow), transparent 55%),
        linear-gradient(180deg, rgba(22, 28, 40, 0.92) 0%, rgba(10, 14, 22, 0.96) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    overflow: visible;
}
.mkt-card.is-dw { --accent: #6ec8ff; --glow: rgba(110, 200, 255, 0.42); }
.mkt-card.is-bk { --accent: #ff9a3c; --glow: rgba(255, 154, 60, 0.4); }
.mkt-card.is-elf { --accent: #5fe08a; --glow: rgba(95, 224, 138, 0.4); }
.mkt-card.is-dl { --accent: #c084fc; --glow: rgba(192, 132, 252, 0.42); }
.mkt-card.is-sum { --accent: #f472b6; --glow: rgba(244, 114, 182, 0.4); }
.mkt-card.is-rf { --accent: #fb7185; --glow: rgba(251, 113, 133, 0.42); }

.mkt-card__hero {
    position: absolute;
    left: 50%;
    top: -96px;
    transform: translateX(-50%);
    width: 150px;
    height: 168px;
    z-index: 3;
    pointer-events: none;
}
.mkt-card__orb {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    width: 118px;
    height: 118px;
    border-radius: 50%;
    background:
        radial-gradient(circle at 35% 30%, rgba(255,255,255,0.55), transparent 28%),
        radial-gradient(circle at 50% 55%, var(--accent), rgba(0,0,0,0.15) 72%);
    box-shadow:
        0 0 28px var(--glow),
        inset 0 -10px 22px rgba(0,0,0,0.25);
}
.mkt-card__art {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    max-height: 168px;
    max-width: 150px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px rgba(0,0,0,0.55));
    transition: transform 0.25s ease;
}
.mkt-card:hover .mkt-card__art {
    transform: translateX(-50%) translateY(-6px) scale(1.04);
}

.mkt-card__name {
    margin: 0;
    text-align: center;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.15;
}
.mkt-card__class {
    display: block;
    text-align: center;
    margin-top: 4px;
    margin-bottom: 14px;
    color: rgba(255,255,255,0.45);
    font-size: 13px;
}

.mkt-primary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}
.mkt-primary div {
    text-align: center;
}
.mkt-primary strong {
    display: block;
    color: #ffb84d;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
}
.mkt-primary span {
    display: block;
    margin-top: 3px;
    color: rgba(255,255,255,0.4);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.mkt-rows {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 14px;
    flex: 1;
}
.mkt-rows > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: rgba(255,255,255,0.78);
}
.mkt-rows strong {
    color: #ffb84d;
    font-weight: 700;
    font-size: 13px;
}

.mkt-price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgba(255,255,255,0.04);
