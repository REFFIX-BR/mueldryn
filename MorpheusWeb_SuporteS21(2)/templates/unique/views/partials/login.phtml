<?php if (logged_in()): ?>
    <p class="title">
        <i class="fa fa-user"></i>
        <?= __('Helo') ?>, <i><?= user()->getName() ?></i>
    </p>
    <div class="account-type">
        <?php if (user()->getVipType()): ?>
            <img src="<?= asset_to('/images/vip.png') ?>" />
        <?php else: ?>
            <img src="<?= asset_to('/images/free.png') ?>" />
        <?php endif ?>
    </div>

    <?php
        $jbCounts = \Morpheus\Account\JewelBank::counts(user());
        $jbCatalog = \Morpheus\Account\JewelBank::catalog();
    ?>
    <div class="jewel-bank-panel">
        <div class="jewel-bank-panel__title">Banco de Joias</div>
        <div class="jewel-bank-panel__grid">
            <?php foreach ($jbCatalog as $code => $meta): ?>
                <div class="jewel-bank-panel__item" title="<?= htmlspecialchars($meta['name']) ?>">
                    <img src="<?= resource_to('/images/items/' . $meta['image']) ?>" alt="<?= htmlspecialchars($meta['short']) ?>">
                    <span><?= (int) $jbCounts[$code] ?></span>
                </div>
            <?php endforeach; ?>
        </div>
    </div>

    <ul class="info">
        <li><i class="fa fa-wallet"></i> <?= __('Credits') ?>: <span class="badge badge-success ml-2"><?= util('Number')->currency(user()->getCredit()) ?></span></li>
        <?php foreach (config('coins', []) as $id => $coin): ?>
            <li><i class="fa fa-coins"></i> <?= $coin['name'] ?>: <span class="badge badge-warning ml-2"><?= util('Number')->format(user()->getCoin($coin['id'])) ?></span></li>
        <?php endforeach ?>
        <?php if (config('vip.column_type')): ?>
            <li><i class="fa fa-info-circle"></i> <?= __('Account type') ?>: <?= util('Account')->vipName(user()->getVipType()) ?></li>
            <?php if (user()->getVipType()): ?>
                <li><i class="fa fa-info-circle"></i> <?= __('Maturity') ?>: <?= (user()->getVipExpire() ? user()->getVipExpire()->format('d/m/Y') : '') ?></li>
            <?php endif ?>
        <?php endif ?>
    </ul>

    <ul class="services">
        <?php foreach (util('Hash')->nest(user()->getAvaliableServices()) as $service): ?>
            <li>
                <a data-ajax href="<?= url_to(empty($service['url']) && !empty($service['children']) ? $service['children'][0]['url'] : $service['url']) ?>"><?= $service['name'] ?></a>

                <?php if ($service['notification'] > 0): ?>
                    <span class="badge badge-danger"><?= $service['notification'] ?></span>
                <?php endif ?>
            </li>
        <?php endforeach ?>
    </ul>

    <a data-ajax-logout href="<?= url_to('/logout') ?>" class="logout">
        <i class="fa fa-power-off"></i> <?= __('Logout') ?>
    </a>
<?php else: ?>
    <p class="title"><?= __('Panel of control') ?></p>

    <form data-ajax-login action="<?= url_to('/login') ?>" method="post">
        <?= function_exists('csrf_field') ? csrf_field() : '' ?>

        <div class="form-group">
            <input type="text" name="username" class="form-control form-control-sm" placeholder="<?= __('Username') ?>" class="login-input" />
        </div>

        <div class="form-group">
            <input type="password" name="password" class="form-control form-control-sm" placeholder="<?= __('Password') ?>" class="login-input" />
        </div>

        <?php if (plugin_active('AuthRemember')): ?>
            <div class="form-group">
                <input class="styled-checkbox" type="checkbox" value="1" name="remember" id="remember" />
                <label for="remember"><?= __('Remember login') ?></label>
            </div>
        <?php endif ?>

        <div class="form-group">
            <input type="submit" value="<?= __('Login') ?>" class="btn btn-sm btn-block btn-info login-submit mb-2" />

            <div class="loading-login text-center" style="display:none">
                <img src="<?= asset_to('/images/load.gif') ?>" width="70" />
            </div>
        </div>

        <?php if (plugin_active('SocialNetwork')): ?>
            <div class="social-login">
                <?php if (config('sn.facebook.login', false)): ?>
                    <a class="btn btn-block btn-primary btn-sm" href="<?= url_to('/social/connect/facebook') ?>"><i class="fab fa-facebook-f"></i> Facebook</a>
                <?php endif ?>

                <?php if (config('sn.google.login', false)): ?>
                    <a class="btn btn-block btn-danger btn-sm" href="<?= url_to('/social/connect/google') ?>"><i class="fab fa-google"></i> Google</a>
                <?php endif ?>
            </div>
        <?php endif ?>
    </form>

    <div class="forgot-password text-center">
        <a data-ajax href="<?= url_to('/forgot-password') ?>" class="link"><?= __('Forgot password?') ?></a>
    </div>

<?php endif ?>
