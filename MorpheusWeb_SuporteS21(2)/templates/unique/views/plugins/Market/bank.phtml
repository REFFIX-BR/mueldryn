$bankImgSrc = function ($image) {
    $image = (string) $image;
    if ($image === '') {
        return '';
    }
    if (preg_match('#^https?://#i', $image)) {
        return $image;
    }
    return full_url() . $image;
};
$fmtZen = function ($n) {
    return number_format((int) $n, 0, ',', ' ');
};
