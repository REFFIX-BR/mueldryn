<script>
(function(){
    var selected = null;
    var connected = <?= $connected ? 'true' : 'false' ?>;
    var withdrawBase = <?= json_encode(url_to('/market/bank/withdraw')) ?>;
    var depositUrl = <?= json_encode(url_to('/market/bank/deposit')) ?>;
    var zenUrl = <?= json_encode(url_to('/market/bank/zen')) ?>;
    var bankUrl = <?= json_encode(url_to('/market/bank')) ?>;
    var sellUrl = <?= json_encode(url_to('/market/sell')) ?>;

    function updateActions() {
        var btnSell = document.getElementById('btnSell');
        var btnTransfer = document.getElementById('btnTransfer');
        var canAct = !connected && selected;
        btnTransfer.disabled = !canAct;
        btnSell.disabled = !(canAct && selected && selected.side === 'site');

        var transferVisual = document.getElementById('transferVisual');
        var transferLabel = document.getElementById('transferLabel');

        if (!selected) {
            transferVisual.setAttribute('data-dir', 'idle');
            transferLabel.textContent = 'Transferir';
            btnTransfer.title = 'Selecione um item';
        } else if (selected.side === 'game') {
            transferVisual.setAttribute('data-dir', 'to-site');
            transferLabel.textContent = 'Para o Site';
            btnTransfer.title = 'Enviar para o Banco do Site';
        } else {
            transferVisual.setAttribute('data-dir', 'to-game');
            transferLabel.textContent = 'Para o Jogo';
            btnTransfer.title = 'Enviar para o Baú do Jogo';
        }
    }

    function clearSel() {
        document.querySelectorAll('.account-bank__slot.is-on').forEach(function(el){ el.classList.remove('is-on'); });
        selected = null;
        updateActions();
    }

    document.querySelectorAll('.account-bank__slot.has-item').forEach(function(cell){
        cell.addEventListener('click', function(){
            clearSel();
            cell.classList.add('is-on');
            selected = { side: cell.getAttribute('data-side'), id: cell.getAttribute('data-id') };
            updateActions();
        });
    });

    function postAjax(url, data) {
        if (typeof jQuery === 'undefined') { alert('jQuery indisponível'); return; }
        jQuery.ajax({
            url: url, type: 'POST', data: data || {},
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).done(function(res){
            if (typeof res === 'string') { try { res = JSON.parse(res); } catch(e){} }
            if (res && res.success === false) { alert(res.message || 'Erro'); return; }
            var redirect = (res && res.redirect) ? res.redirect : bankUrl;
            var $a = jQuery('<a data-ajax href="'+redirect+'" style="display:none"></a>').appendTo('body');
            $a.trigger('click');
            setTimeout(function(){ $a.remove(); }, 80);
        }).fail(function(xhr){
            var msg = 'Falha na transferência';
            try { var r = JSON.parse(xhr.responseText); if (r.message) msg = r.message; } catch(e){}
            alert(msg);
        });
    }

    document.getElementById('btnTransfer').addEventListener('click', function(){
        if (connected) return;
        if (!selected) { alert('Selecione um item.'); return; }
        if (selected.side === 'game') {
            postAjax(depositUrl, { vault_item_id: selected.id });
        } else {
            postAjax(withdrawBase.replace(/\/$/,'') + '/' + selected.id, {});
        }
    });

    document.getElementById('btnZen').addEventListener('click', function(){
        if (connected) return;
        var toSite = parseInt(document.getElementById('zenToSite').value, 10) || 0;
        var toGame = parseInt(document.getElementById('zenToGame').value, 10) || 0;
        if (toSite > 0 && toGame > 0) { alert('Preencha só um campo de Zen por vez.'); return; }
        if (toSite <= 0 && toGame <= 0) { alert('Informe o valor de Zen.'); return; }
        if (toSite > 0) postAjax(zenUrl, { amount: toSite, dir: 'to_site' });
        else postAjax(zenUrl, { amount: toGame, dir: 'to_game' });
    });

    document.getElementById('btnSell').addEventListener('click', function(){
        if (connected || !selected || selected.side !== 'site') return;
        var $a = jQuery('<a data-ajax href="'+sellUrl+'?site_bank='+encodeURIComponent(selected.id)+'" style="display:none"></a>').appendTo('body');
        $a.trigger('click');
        setTimeout(function(){ $a.remove(); }, 80);
    });

    updateActions();
})();
</script>
