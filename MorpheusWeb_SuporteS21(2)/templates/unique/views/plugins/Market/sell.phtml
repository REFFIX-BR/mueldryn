<script>
(function(){
    var sellUrl = <?= json_encode(url_to('/market/sell')) ?>;
    var payment = document.getElementById('payment');
    var tabs = document.querySelectorAll('#muSellModal .mu-sell-tab');
    var btn = document.getElementById('sellBtn');
    var form = document.getElementById('muSellForm');
    var $modal = $('#muSellModal');

    function showPanel(pay) {
        payment.value = pay;
        ['zen','coin','jewels'].forEach(function(p){
            document.getElementById('panel-' + p).style.display = (p === pay) ? '' : 'none';
        });
        tabs.forEach(function(t){
            t.classList.toggle('is-on', t.getAttribute('data-pay') === pay);
        });
        validate();
    }

    function jewelSum() {
        var s = 0;
        <?php foreach ($jewelCatalog as $code => $meta): ?>
        s += parseInt(document.getElementById('price_<?= $code ?>').value, 10) || 0;
        <?php endforeach; ?>
        return s;
    }

    function validate() {
        var pay = payment.value;
        var ok = false;
        if (pay === 'jewels') ok = jewelSum() > 0;
        if (pay === 'zen') ok = (parseInt(document.getElementById('price_zen').value, 10) || 0) > 0;
        if (pay === 'coin') ok = (parseInt(document.getElementById('price_coin').value, 10) || 0) > 0;
        btn.disabled = !ok;
    }

    tabs.forEach(function(t){
        t.addEventListener('click', function(){ showPanel(t.getAttribute('data-pay')); });
    });

    document.querySelectorAll('#muSellModal .jq-minus').forEach(function(b){
        b.addEventListener('click', function(){
            var el = document.getElementById(b.getAttribute('data-target'));
            el.value = Math.max(0, (parseInt(el.value,10)||0) - 1);
            validate();
        });
    });
    document.querySelectorAll('#muSellModal .jq-plus').forEach(function(b){
        b.addEventListener('click', function(){
            var el = document.getElementById(b.getAttribute('data-target'));
            el.value = (parseInt(el.value,10)||0) + 1;
            validate();
        });
    });

    form.addEventListener('input', validate);
    form.addEventListener('submit', function(){
        var pay = payment.value;
        var hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'price';
        if (pay === 'zen') hidden.value = document.getElementById('price_zen').value || 0;
        else if (pay === 'coin') hidden.value = document.getElementById('price_coin').value || 0;
        else hidden.value = 0;
        form.appendChild(hidden);
    });

    showPanel('jewels');

    function destroyMuSellModal(alreadyHidden) {
        var $m = $('#muSellModal');
        if ($m.length) {
            $m.off('hidden.bs.modal');
            if (!alreadyHidden) {
                try { $m.modal('hide'); } catch (e) {}
                return;
            }
            $m.remove();
        }
        $('.modal-backdrop').remove();
        $('body').removeClass('modal-open').css('padding-right', '');
        $(document).off('ajaxSuccess.muSellModal pjax:send.muSellModal');
    }

    // Fecha modal ao vender com sucesso (ele fica no body e sobrevive ao pjax)
    $(document).on('ajaxSuccess.muSellModal', function(e, xhr, settings) {
        var url = settings.url || '';
        if (url.indexOf('market/sell') === -1) return;
        var data;
        try {
            data = xhr.responseJSON || JSON.parse(xhr.responseText);
        } catch (err) { return; }
        if (data && data.success !== false) {
            destroyMuSellModal(true);
        }
    });

    // Segurança: remove modal/backdrop ao trocar de página via ajax
    $(document).on('pjax:send.muSellModal', function() {
        destroyMuSellModal(true);
    });

    // Move modal to body so backdrop/position work inside ajax layout
    $modal.appendTo('body');
    $modal.modal({ backdrop: true, keyboard: true, show: true });

    $modal.on('hidden.bs.modal', function(){
        destroyMuSellModal(true);
        var $link = $('<a data-ajax href="' + sellUrl + '" style="display:none"></a>').appendTo('body');
        $link.trigger('click');
        setTimeout(function(){ $link.remove(); }, 50);
    });
})();
</script>
