        $baseQs = array();
        if (!empty($q)) $baseQs['q'] = $q;
        if ($category !== null && $category !== '') $baseQs['category'] = $category;
        if (!empty($pay)) $baseQs['pay'] = $pay;
        if (!empty($optLuck)) $baseQs['luck'] = 1;
        if (!empty($optSkill)) $baseQs['skill'] = 1;
        if (!empty($optExe)) $baseQs['exe'] = 1;
        $chipUrl = function ($overrides) use ($baseQs) {
            $qs = array_merge($baseQs, $overrides);
            foreach ($qs as $k => $v) {
                if ($v === null || $v === '' || $v === false) unset($qs[$k]);
            }
            return url_to('/market' . (empty($qs) ? '' : '?' . http_build_query($qs)));
        };
