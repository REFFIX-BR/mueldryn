<script>
(function () {
    function bindVipCards(root) {
        var cards = (root || document).querySelectorAll('[data-vip-card]');
        for (var i = 0; i < cards.length; i++) {
            (function (card) {
                var select = card.querySelector('[data-vip-days]');
                var buy = card.querySelector('[data-vip-buy]');
                var price = card.querySelector('[data-vip-price]');
                var old = card.querySelector('[data-vip-old]');
                if (!select || !buy) return;
                function sync() {
                    var opt = select.options[select.selectedIndex];
                    if (!opt) return;
                    buy.href = buy.href.replace(/\/packages\/buy\/\d+/, '/packages/buy/' + opt.value);
                    if (price) {
                        price.innerHTML = opt.getAttribute('data-price') + ' <span>Créditos</span>';
                    }
                    if (old) {
                        var ov = opt.getAttribute('data-old');
                        if (ov) {
                            old.textContent = ov + ' Créditos';
                            old.classList.remove('is-empty');
                        } else {
                            old.textContent = '';
                            old.classList.add('is-empty');
                        }
                    }
                }
                select.addEventListener('change', sync);
                sync();
            })(cards[i]);
        }
    }
    bindVipCards(document);
    if (window.jQuery) {
        jQuery(document).off('pjax:end.vipcards').on('pjax:end.vipcards', function () {
            bindVipCards(document);
        });
    }
})();
</script>
