<script>
(function () {
    var el = document.querySelector('[data-skins-reset]');
    if (el) {
        var target = new Date(el.getAttribute('data-skins-reset')).getTime();
        var out = el.querySelector('.eldryn-skins__countdown');
        function tick() {
            var diff = Math.max(0, target - Date.now());
            var h = Math.floor(diff / 3600000);
            var m = Math.floor((diff % 3600000) / 60000);
            var s = Math.floor((diff % 60000) / 1000);
            function pad(n) { return (n < 10 ? '0' : '') + n; }
            out.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
        }
        tick();
        setInterval(tick, 1000);
    }

    function playSkinVideos() {
        var videos = document.querySelectorAll('.eldryn-skin__video');
        for (var i = 0; i < videos.length; i++) {
            if (!videos[i].play) continue;
            try {
                videos[i].muted = true;
                var p = videos[i].play();
                if (p && typeof p.catch === 'function') p.catch(function () {});
            } catch (e) {}
        }
    }
    playSkinVideos();
    if (window.jQuery) {
        jQuery(document).off('pjax:end.skins').on('pjax:end.skins', playSkinVideos);
    }
})();
</script>
