<script>
(function(){
    var root = document.querySelector('.mkt-info');
    if (!root) return;

    root.querySelectorAll('.mkt-info__tab').forEach(function(tab){
        tab.addEventListener('click', function(){
            var name = tab.getAttribute('data-tab');
            root.querySelectorAll('.mkt-info__tab').forEach(function(t){ t.classList.remove('is-active'); });
            root.querySelectorAll('.mkt-info__tabpanel').forEach(function(p){ p.classList.remove('is-active'); });
            tab.classList.add('is-active');
            var panel = root.querySelector('.mkt-info__tabpanel[data-panel="' + name + '"]');
            if (panel) panel.classList.add('is-active');
        });
    });
})();
</script>
