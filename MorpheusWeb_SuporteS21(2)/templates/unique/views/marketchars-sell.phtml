<script>
$(document).ready(function() {
    function updatePreview() {
        var selectedChar = $('#charSelect option:selected');
        var name = selectedChar.val();
        
        if (name) {
            $('#previewName').text(name);
            var icon = selectedChar.data('icon');
            $('#previewAvatar').attr('src', icon || '<?= asset_to('/images/classes/dw.png') ?>');
            $('#previewClass').text(selectedChar.data('class'));
            $('#previewLevel').text(selectedChar.data('level'));
            $('#previewResets').text(selectedChar.data('resets'));
            $('#previewMResets').text(selectedChar.data('mresets'));
            
            $('#previewStr').text(selectedChar.data('str'));
            $('#previewAgi').text(selectedChar.data('agi'));
            $('#previewVit').text(selectedChar.data('vit'));
            $('#previewEne').text(selectedChar.data('ene'));
            
            if (selectedChar.data('cmd') > 0) {
                $('#previewCmdRow').css('display', 'flex').show();
                $('#previewCmd').text(selectedChar.data('cmd'));
            } else {
                $('#previewCmdRow').hide();
            }
        } else {
            $('#previewName').text('Nome do Char');
            $('#previewAvatar').attr('src', '<?= asset_to('/images/classes/dw.png') ?>');
            $('#previewClass').text('Classe');
            $('#previewLevel').text('0');
            $('#previewResets').text('0');
            $('#previewMResets').text('0');
            $('#previewStr').text('0');
            $('#previewAgi').text('0');
            $('#previewVit').text('0');
            $('#previewEne').text('0');
            $('#previewCmdRow').hide();
        }

        var price = $('#priceInput').val();
        var coinName = $('#coinSelect option:selected').data('name');
        if (price && Number(price) > 0 && coinName) {
            $('#previewPrice').text(Number(price).toLocaleString('pt-BR'));
            $('#previewCoin').text(coinName).show();
        } else {
            $('#previewPrice').text('');
            $('#previewCoin').text('').hide();
        }

        var jewelsHtml = '';
        $('.jewel-price-input').each(function() {
            var v = parseInt($(this).val(), 10) || 0;
            if (v > 0) {
                var img = $(this).closest('div').find('img').attr('src');
                jewelsHtml += '<div style="text-align:center;min-width:36px;"><img src="'+img+'" style="width:26px;height:26px;"><div style="color:#ffb84d;font-size:11px;font-weight:700;">'+v+'</div></div>';
            }
        });
        $('#previewJewels').html(jewelsHtml || '<span style="color:rgba(255,255,255,0.4);font-size:12px;">Sem joias</span>');
    }

    $('#charSelect, #priceInput, #coinSelect, .jewel-price-input').on('change keyup input', updatePreview);
    updatePreview();
});
</script>
