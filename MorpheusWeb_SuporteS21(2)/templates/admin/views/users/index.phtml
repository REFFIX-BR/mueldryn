<section class="content-header">
    <h1><?= __('Users') ?></h1>

    <div class="actions">
        <a data-ajax class="btn btn-success btn-sm" href="<?= url_to('/admin/users/add') ?>"><?= __('Add') ?></a>
    </div>
</section>

