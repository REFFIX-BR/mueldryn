<script>
    var reqIndex = <?= isset($achievement['requirements']) ? count($achievement['requirements']) : 0 ?>;
    function addRequirement() { $('#requirements_list').append('<div class="well requirement-item"><button type="button" class="close text-danger" onclick="$(this).parent().remove()">&times;</button><div class="form-group"><label>Título do Requisito</label><input type="text" name="requirements[' + reqIndex + '][title]" class="form-control"></div><div class="form-group"><label>Consulta SQL</label><textarea name="requirements[' + reqIndex + '][sql]" class="form-control" rows="2"></textarea></div></div>'); reqIndex++; }

    var rewIndex = <?= isset($achievement['rewards']) ? count($achievement['rewards']) : 0 ?>;
    function addReward() { $('#rewards_list').append('<div class="well reward-item"><button type="button" class="close text-danger" onclick="$(this).parent().remove()">&times;</button><div class="form-group"><label>Título da Recompensa</label><input type="text" name="rewards[' + rewIndex + '][title]" class="form-control"></div><div class="form-group"><label>Consulta SQL</label><textarea name="rewards[' + rewIndex + '][sql]" class="form-control" rows="2"></textarea></div></div>'); rewIndex++; }
</script>