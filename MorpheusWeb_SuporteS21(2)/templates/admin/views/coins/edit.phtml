<script>
function loadColumns(table, selectedColumn, selectedForeignKey) {
    var columnSelect = document.getElementById('coins-column');
    var foreignKeySelect = document.getElementById('coins-foreign-key');
    
    if (!table) {
        columnSelect.innerHTML = '<option value="">Select a table first</option>';
        foreignKeySelect.innerHTML = '<option value="">Select a table first</option>';
        return;
    }
    
    var xhr = new XMLHttpRequest();
    xhr.open('GET', '<?= url_to('/admin/coins/columns/') ?>' + encodeURIComponent(table), true);
    xhr.onreadystatechange = function() {
        if (xhr.readyState === 4 && xhr.status === 200) {
            var columns = JSON.parse(xhr.responseText);
            var options = '<option value="">Select a column</option>';
            columns.forEach(function(col) {
                var selected1 = col.COLUMN_NAME == selectedColumn ? ' selected' : '';
                var selected2 = col.COLUMN_NAME == selectedForeignKey ? ' selected' : '';
                options += '<option value="' + col.COLUMN_NAME + '"' + selected1 + '>' + col.COLUMN_NAME + '</option>';
            });
            columnSelect.innerHTML = options;
            
            var options2 = '<option value="">Select a column</option>';
            columns.forEach(function(col) {
                var selected2 = col.COLUMN_NAME == selectedForeignKey ? ' selected' : '';
                options2 += '<option value="' + col.COLUMN_NAME + '"' + selected2 + '>' + col.COLUMN_NAME + '</option>';
            });
            foreignKeySelect.innerHTML = options2;
        }
    };
    xhr.send();
}

document.getElementById('coins-table').addEventListener('change', function() {
    loadColumns(this.value, '', '');
});

loadColumns('<?= $coin['table'] ?>', '<?= $coin['column'] ?>', '<?= $coin['foreign_key'] ?>');
</script>