<script>
$(function () {
    function loadColumns(table, selectedAccount, selectedType, selectedExpire) {
        var $account = $("#config-vip-column-account");
        var $type = $("#config-vip-column-type");
        var $expire = $("#config-vip-column-expire");
        
        if (!table) {
            $account.html('<option value=""><?= __('Select a table first') ?></option>');
            $type.html('<option value=""><?= __('Select a table first') ?></option>');
            $expire.html('<option value=""><?= __('Select a table first') ?></option>');
            return;
        }
        
        var apiBase = typeof base !== 'undefined' ? base : '<?= url_to('/') ?>';
        $.getJSON(apiBase + "admin/sql/columns/" + table, function (data) {
            var options = '<option value="">Select a column</option>';
            $.each(data, function (key, value) {
                options += '<option value="' + value.COLUMN_NAME + '">' + value.COLUMN_NAME + '</option>';
            });
            $account.html(options).val(selectedAccount);
            $type.html(options).val(selectedType);
            $expire.html(options).val(selectedExpire);
        });
    }

    $("#config-vip-table").change(function () {
        loadColumns($(this).val(), '', '', '');
    });

    var currentTable = $("#config-vip-table").val();
    if (currentTable) {
        loadColumns(currentTable, '<?= isset($vip['column_account']) ? $vip['column_account'] : '' ?>', '<?= isset($vip['column_type']) ? $vip['column_type'] : '' ?>', '<?= isset($vip['column_expire']) ? $vip['column_expire'] : '' ?>');
    }
});
</script>