<section class="content-header">
    <h1>Contas</h1>
</section>

<section class="content">
    <div class="box">
        <div class="box-body">
            <form action="<?= url_to('/admin/characters/loggedin') ?>" method="GET">
                <div class="input-group">
                    <input type="text" name="q" class="form-control" placeholder="Buscar por conta, personagem, e-mail ou IP..." value="<?= isset($q) ? htmlspecialchars($q) : '' ?>">
                    <span class="input-group-btn">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> <?= __('Search') ?></button>
                    </span>
                </div>
            </form>
        </div>
    </div>

    <?php if (empty($accounts)): ?>
        <div class="callout callout-warning">
            <h4>Ops!</h4>
            <p><?= __('No account found') ?></p>
        </div>
    <?php else: ?>
        <div class="box">
            <div class="box-body no-padding">
                <table class="table table-condensed table-hover table-striped">
                    <thead>
                        <tr>
                            <th><?= __('Account') ?></th>
                            <th><?= __('Characters') ?></th>
                            <th><?= __('Email') ?></th>
                            <th>Último IP</th>
                            <th width="10"></th>
                        </tr>
                    </thead>

                    <tbody>
                        <?php foreach ($accounts as $account): ?>
                            <tr>
                                <td><a data-ajax href="<?= url_to('/admin/accounts/edit/' . $account['account']) ?>"><?= $account['account'] ?></a></td>
                                <td>
                                    <?php if (is_array($account['characters'])): ?>
                                        <?php foreach ($account['characters'] as $character): ?>
                                            <a class="btn btn-xs btn-default" data-ajax href="<?= url_to('/admin/characters/edit/' . $character) ?>"><?= $character ?></a>
                                        <?php endforeach; ?>
                                    <?php else: ?>
                                        <?= $account['characters'] ?>
                                    <?php endif; ?>
                                </td>
                                <td><?= $account['email'] ?></td>
                                <td><?= $account['ip'] ?></td>
                                <td class="record-actions">
                                    <a class="btn btn-xs btn-default" data-ajax href="<?= url_to('/admin/accounts/edit/' . $account['account']) ?>"><?= __('Edit') ?></a>
                                </td>
                            </tr>
                        <?php endforeach ?>
                    </tbody>
                </table>
            </div>
            <?php if (isset($totalPages) && $totalPages > 1): ?>
                <div class="box-footer clearfix">
                    <ul class="pagination pagination-sm no-margin pull-right">
                        <?php if ($page > 1): ?>
                            <li><a href="?q=<?= isset($q) ? htmlspecialchars($q) : '' ?>&page=1">&laquo;&laquo;</a></li>
                            <li><a href="?q=<?= isset($q) ? htmlspecialchars($q) : '' ?>&page=<?= $page - 1 ?>">&laquo;</a></li>
                        <?php endif; ?>

                        <?php for ($i = max(1, $page - 5); $i <= min($totalPages, $page + 5); $i++): ?>
                            <li class="<?= $i == $page ? 'active' : '' ?>"><a href="?q=<?= isset($q) ? htmlspecialchars($q) : '' ?>&page=<?= $i ?>"><?= $i ?></a></li>
                        <?php endfor; ?>

                        <?php if ($page < $totalPages): ?>
                            <li><a href="?q=<?= isset($q) ? htmlspecialchars($q) : '' ?>&page=<?= $page + 1 ?>">Próximo &raquo;</a></li>
                           <!-- <li><a href="?q=<?= isset($q) ? htmlspecialchars($q) : '' ?>&page=<?= $totalPages ?>">&raquo;&raquo;</a></li> -->
                        <?php endif; ?>
                    </ul>
                </div>
            <?php endif; ?>
        </div>
    <?php endif ?>
</section>