<section class="content-header">
    <h1><?= __('Coupons') ?></h1>

    <div class="actions">
        <a data-ajax class="btn btn-success btn-sm" href="<?= url_to('/admin/webshop/coupons/add') ?>"><?= __('Add') ?></a>
    </div>
