                <li><a data-btn-action data-ajax-action data-confirm="<?= __('You are sure?') ?>" href="<?= url_to('/admin/webshop/products/deactivate?page=' . $page) ?>"><?= __('Deactivate') ?></a></li>
                <li><a data-btn-action data-ajax-action data-confirm="<?= __('You are sure?') ?>" href="<?= url_to('/admin/webshop/products/delete-all?page=' . $page) ?>"><?= __('Delete') ?></a></li>
