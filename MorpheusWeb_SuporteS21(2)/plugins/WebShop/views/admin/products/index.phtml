<script>
    $(function () {
        $("[data-select-all]").click(function (e) {
            var $this = $(this);
            var check = $this.attr("checked");

            if (!check) {
                $("#products-table :checkbox").icheck('checked');
                $this.attr("checked", true);
            } else {
                $("#products-table :checkbox").icheck('unchecked');
                $this.attr("checked", false);
            }

            e.preventDefault();
        });

        $("[data-btn-action]").click(function (e) {
            var $this = $(this);
            var $inputs = $("#products-table :checkbox:checked");

            var ids = "";
            $inputs.each(function () {
                if (ids !== "") {
                    ids += ",";
                }
                ids += $(this).val();
            });

            $this.attr("href", $this.attr("href") + "&ids=" + ids);
        });
    });
</script>

