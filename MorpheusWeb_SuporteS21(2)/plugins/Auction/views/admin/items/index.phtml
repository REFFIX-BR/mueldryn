<section class="content-header">
    <h1><?= __('Auction items') ?></h1>

    <div class="actions">
        <a data-ajax class="btn btn-success btn-sm" href="/admin/auctions/items/add?auction_id=<?= $auction['id'] ?>"><?= __('Add') ?></a>
    </div>
</section>

<section class="content">
    <div class="nav-tabs-custom">
        <ul class="nav nav-tabs">
            <li><a data-ajax href="/admin/auctions/edit/<?= $auction['id'] ?>"><?= __('Auction') ?></a></li>
            <li class="active"><a href="#"><?= __('Items') ?></a></li>
        </ul>
        <div class="tab-content" style="<?= empty($items) ? '' : 'padding:0' ?>">
            <?php if (empty($items)): ?>
                <div class="callout callout-warning" style="margin-bottom:0">
                    <h4>Ops!</h4>
                    <p><?= __('No items found') ?></p>
                </div>
            <?php else: ?>
                <table id="shops-table" class="table table-condensed table-hover table-striped">
                    <thead>
                        <tr>
                            <th><?= __('Name') ?></th>
                            <th><?= __('Winner') ?></th>
                            <th>Término do Lance</th>
                            <th><?= __('Winner date') ?></th>
                            <th><?= __('Delivery') ?></th>
                            <th width="80"></th>
                        </tr>
                    </thead>

                    <tbody>
                        <?php foreach ($items as $item): ?>
                            <tr class="<?= $item['active'] ? 'border-success' : 'border-error' ?>">
                                <td>
                                    <?php 
                                        try {
                                            $itemObj = new \Morpheus\Item\Item(str_pad($item['item'], 32, '0'));
                                            $itemObj->parse();

                                            $tooltip = method_exists($itemObj, 'info') ? $itemObj->info() : (method_exists($itemObj, 'getTooltip') ? $itemObj->getTooltip() : '');
                                            $img = !empty($item['image']) ? $item['image'] : (method_exists($itemObj, 'image') ? $itemObj->image() : (method_exists($itemObj, 'getImage') ? $itemObj->getImage() : ''));
                                            ?>
                                            <span <?php if($tooltip): ?>data-info="<?= htmlspecialchars($tooltip, ENT_QUOTES, 'UTF-8') ?>"<?php endif; ?>>
                                                <?php if($img): ?>
                                                    <img src="<?= $img ?>" style="max-height: 25px; margin-right: 5px; vertical-align: middle;" />
                                                <?php endif; ?>
                                                <strong><?= $itemObj->getName() ?></strong>
                                            </span>
                                            <?php
                                        } catch (Exception $ex) {
                                            echo '<span class="text-danger">Hex Inválido: ' . htmlspecialchars($ex->getMessage()) . '</span><br><small class="text-muted">' . htmlspecialchars($item['item']) . '</small>';
                                        }
                                    ?>
                                </td>
                                <td>
                                    <?php if (!empty($item['winner'])): ?>
                                        <a data-ajax href="/admin/accounts/edit/<?= $item['winner'] ?>"><?= $item['winner'] ?></a>
                                    <?php endif ?>
                                </td>
                                <td>
                                    <?= !empty($item['end_date']) ? date('d/m/Y H:i:s', strtotime($item['end_date'])) : '-' ?>
                                </td>
                                <td>
                                    <?php if (!empty($item['winner_date'])): ?>
                                        <?= date('d/m/Y H:i:s', strtotime($item['winner_date'])) ?>
                                    <?php endif ?>
                                </td>
                                <td><?= $item['delivery'] ? 'Sim' : 'Não' ?></td>
                                <td class="record-actions">
                                    <?php if ($item['can_delivery']): ?>
                                        <a data-ajax-action class="btn btn-xs btn-default" href="/admin/auctions/items/delivery/<?= $item['id'] ?>"><?= __('Delivery') ?></a>
                                    <?php endif ?>
                                    <a data-ajax class="btn btn-xs btn-default" href="/admin/auctions/items/edit/<?= $item['id'] ?>"><?= __('Edit') ?></a>
                                    <a data-ajax-delete class="btn btn-danger btn-xs" href="/admin/auctions/items/delete/<?= $item['id'] ?>"><?= __('Delete') ?></a>
                                </td>
                            </tr>
                        <?php endforeach ?>
                    </tbody>
                </table>
            <?php endif ?>
        </div>
    </div>
</section>
