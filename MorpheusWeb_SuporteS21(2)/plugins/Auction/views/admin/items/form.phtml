<script>
$(function() {
    function updateExcLabels(category, index) {
        var isWeapon = (category >= 0 && category <= 5) || (category === 13 && [12, 13, 14, 21, 22, 23, 24, 25, 26, 27, 28].indexOf(index) !== -1);
        
        if (isWeapon) {
            $('#lbl_exc_32').text("Mana após matar monstro +Mana/8");
            $('#lbl_exc_16').text("Vida após matar monstro +Vida/8");
            $('#lbl_exc_8').text("Velocidade de Ataque +7");
            $('#lbl_exc_4').text("Aumenta Dano +2%");
            $('#lbl_exc_2').text("Aumenta Dano +Level/20");
            $('#lbl_exc_1').text("Dano Excelente Rate +10%");
        } else {
            $('#lbl_exc_32').text("Aumenta Zen após matar monstro +30%");
            $('#lbl_exc_16').text("Taxa de Defesa com Sucesso +10%");
            $('#lbl_exc_8').text("Reflete o Dano +5%");
            $('#lbl_exc_4').text("Diminui o Dano +4%");
            $('#lbl_exc_2').text("Aumenta Mana Máxima +4%");
            $('#lbl_exc_1').text("Aumenta Vida Máxima +4%");
        }
    }

    function buildHex() {
        var category = parseInt($('#im_category').val()) || 0;
        var index = parseInt($('#im_index').val()) || 0;
        var level = parseInt($('#im_level').val()) || 0;
        var skill = $('#im_skill').is(':checked') ? 128 : 0;
        var luck = $('#im_luck').is(':checked') ? 4 : 0;
        var opt = parseInt($('#im_opt').val()) || 0;
        
        updateExcLabels(category, index);

        var exc = 0;
        $('.im_exc:checked').each(function() {
            exc += parseInt($(this).val());
        });

        var byte0 = index & 255;
        
        var optLvl = level * 8;
        var optData = (opt & 3);
        var byte1 = skill + optLvl + luck + optData;
        
        var byte2 = 255; // Durabilidade Máxima Padrão
        
        var byte7 = exc;
        
        var catByte = (category * 16) & 240;
        var indexHigh = (index > 255) ? 128 : 0;
        var optHigh = (opt > 3) ? 64 : 0;
        var byte9 = catByte | indexHigh | optHigh;

        var hex = new Array(32).fill('0');
        
        function setByte(pos, val) {
            var str = val.toString(16).toUpperCase();
            if (str.length < 2) str = '0' + str;
            hex[pos*2] = str[0];
            hex[pos*2+1] = str[1];
        }
        
        setByte(0, byte0);
        setByte(1, byte1);
        setByte(2, byte2);
        setByte(7, byte7);
        setByte(9, byte9);
        setByte(10, 255);
        
        $('#im_hex_output').val(hex.join(''));
    }

    $('.item-maker-trigger').on('change keyup', function() {
        buildHex();
    });

    function parseHex(hex) {
        if (!hex || hex.length !== 32 || hex === '00000000000000000000000000000000') {
            updateExcLabels(0, 0);
            return;
        }
        var getByte = function(pos) { return parseInt(hex.substring(pos*2, pos*2+2), 16) || 0; };
        
        var byte0 = getByte(0);
        var byte1 = getByte(1);
        var byte7 = getByte(7);
        var byte9 = getByte(9);
        
        var category = (byte9 & 240) >> 4;
        var index = byte0 + (((byte9 & 128) > 0 && category < 12) ? 256 : 0);
        
        updateExcLabels(category, index);
        
        $('#im_category').val(category);
        $('#im_index').val(index);
        $('#im_level').val((byte1 >> 3) & 15);
        $('#im_skill').prop('checked', (byte1 & 128) > 0);
        $('#im_luck').prop('checked', (byte1 & 4) > 0);
        
        var opt = (byte1 & 3) + (((byte9 & 64) > 0) ? 4 : 0);
        $('#im_opt').val(opt);
        
        $('.im_exc').each(function() {
            $(this).prop('checked', (byte7 & parseInt($(this).val())) > 0);
        });
    }

    // Preenche o gerador automaticamente ao abrir a página de edição
    parseHex($('#im_hex_output').val());
});
</script>