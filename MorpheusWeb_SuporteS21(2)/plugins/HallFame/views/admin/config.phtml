            <div class="box-body">
                <fieldset>
                    <legend><?= __('General') ?></legend>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="max-results"><?= __('Max result') ?></label>

                        <div class="col-sm-3">
                            <input class="form-control" type="text" id="max-results" value="<?= config('hallfame.max_results', 1) ?>" name="max_results" />
