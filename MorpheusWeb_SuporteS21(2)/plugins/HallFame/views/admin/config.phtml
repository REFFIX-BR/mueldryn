                            <tr class="drag">
                                <td style="vertical-align:middle">
                                    <input<?= $hallfame && isset($hallfame['active']) && $hallfame['active'] ? ' checked' : '' ?> type="checkbox" name="hallfame[<?= $id ?>][active]" value="1" />
                                </td>
                                <td style="vertical-align:bottom"><input type="text" name="hallfame[<?= $id ?>][name]" value="<?= $hallfame ? $hallfame['name'] : $ranking['name'] ?>" class="form-control" /></td>
                                <td style="vertical-align:middle;text-align:center">
                                    <?php if (isset($ranking['configs']['daily'])): ?>
                                        <input<?= $hallfame['daily'] ? ' checked' : '' ?> type="checkbox" name="hallfame[<?= $id ?>][daily]" value="1" />
                                    <?php endif ?>
                                </td>
                                <td style="vertical-align:middle;text-align:center">
                                    <?php if (isset($ranking['configs']['weekly'])): ?>
                                        <input<?= $hallfame['weekly'] ? ' checked' : '' ?> type="checkbox" name="hallfame[<?= $id ?>][weekly]" value="1" />
                                    <?php endif ?>
                                </td>
                                <td style="vertical-align:middle;text-align:center">
                                    <?php if (isset($ranking['configs']['monthly'])): ?>
                                        <input<?= $hallfame['monthly'] ? ' checked' : '' ?> type="checkbox" name="hallfame[<?= $id ?>][monthly]" value="1" />
                                    <?php endif ?>
                                </td>
                            </tr>
                        <?php endforeach ?>
                        </tbody>
                    </table>
                </fieldset>
            </div>

            <div class="box-footer">
                <input type="submit" class="btn btn-primary" value="<?= __('Save') ?>" />
