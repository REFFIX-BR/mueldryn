                                <th width="10"></th>
                                <th><?= __('Name') ?></th>
                                <th width="60" style="text-align:center"><?= __('Daily') ?></th>
                                <th width="60" style="text-align:center"><?= __('Weekly') ?></th>
                                <th width="60" style="text-align:center"><?= __('Monthly') ?></th>
