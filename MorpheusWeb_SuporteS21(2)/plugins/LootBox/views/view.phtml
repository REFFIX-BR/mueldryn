        <a data-ajax class="btn" href="<?= url_to('/lootboxes/gift/' . $box['id']) ?>"><?= __('Give gift') ?></a>
    </div>
</div>

<script>
$(document).off('click', '.open-box').on('click', '.open-box', function(e) {
        e.preventDefault();
        var url = $(this).attr('href');
        var confirmMsg = $(this).data('confirm');
        
        if (confirm(confirmMsg)) {
            // Cria a tela escura de suspense se ela ainda não existir
            if ($('#lb-overlay').length === 0) {
                $('body').append('<div id="lb-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); z-index:9999; color:#fff; text-align:center; padding-top:10%;"><h1 id="lb-count" style="font-size:150px; margin:0; text-shadow: 0 0 20px #ff9800;">3</h1><h2 id="lb-result" style="display:none; color:#ff9800; font-size:30px; margin:20px 0; text-shadow: 0 0 10px #000;"></h2><button id="lb-close" style="display:none; margin-top:30px; font-size:20px; padding: 10px 30px; cursor:pointer; color: #333; background: #ff9800; border: none; border-radius: 5px;">Continuar</button></div>');
                
                $('#lb-close').on('click', function() {
                    $('#lb-overlay').fadeOut();
                });
            }
            
            // Configuração de exibição inicial
            $('#lb-count').show().text('3');
            $('#lb-result').hide();
            $('#lb-close').hide();
            $('#lb-overlay').fadeIn();
            
            var counter = 3;
            var interval = setInterval(function() {
                counter--;
                if (counter > 0) {
                    $('#lb-count').text(counter);
                } else {
                    clearInterval(interval);
                    $('#lb-count').text('Abrindo...');
                    
                    // Faz a solicitação do item e lê o JSON
                    $.getJSON(url, function(response) {
                        $('#lb-count').hide();
                        var prefix = response.success ? 'Parabéns!<br>' : 'Ops!<br>';
                        var resultHtml = prefix + response.message;
                        
                        // Puxa a imagem da lista de itens com base no index que tiramos na caixa
                        if (response.success && response.index !== undefined) {
                            var imgHtml = $('#item-' + response.index + ' .image').html();
                            if (imgHtml) {
                                resultHtml += '<br><br>' + imgHtml;
                            }
                        }
                        
                        $('#lb-result').html(resultHtml).fadeIn();
                        $('#lb-close').fadeIn();
                    });
                }
            }, 1000); // 1000 milissegundos = 1 segundo de intervalo
        }
});
</script>
