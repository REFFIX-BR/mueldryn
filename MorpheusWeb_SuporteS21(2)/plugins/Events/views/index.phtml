<script>
$(document).ready(function() {
    // Compensa e ajusta a diferença caso a hora do computador do jogador esteja incorreta
    var serverTime = <?= time() ?>;
    var localTime = Math.floor(Date.now() / 1000);
    var timeOffset = serverTime - localTime;

    $('.filter-category').click(function() {
        $('.filter-category').removeClass('active');
        $(this).addClass('active');
        
        var cat = $(this).data('category');
        if (cat == 'all') {
            $('.event-row').fadeIn(200);
        } else {
            $('.event-row').hide();
            $('.event-row[data-category="'+cat+'"]').fadeIn(200);
        }
    });

    setInterval(function() {
        $('.event-countdown').each(function() {
            var ts = $(this).data('timestamp');
            if (!ts) {
                $(this).text('Indisponível').addClass('text-muted');
                return;
            }
            var now = Math.floor(Date.now() / 1000) + timeOffset;
            var diff = ts - now;
            
            if (diff <= 0) {
                $(this).html('<span class="pulse-dot"></span>Ocorrendo!').removeClass('text-danger').addClass('text-success');
            } else {
                var d = Math.floor(diff / 86400);
                var h = Math.floor((diff % 86400) / 3600);
                var m = Math.floor((diff % 3600) / 60);
                var s = diff % 60;
                
                var text = '';
                if (d > 0) text += d + 'd ';
                if (h > 0 || d > 0) text += h + 'h ';
                text += (m < 10 ? '0'+m : m) + 'm ' + (s < 10 ? '0'+s : s) + 's';
                
                $(this).text(text).removeClass('text-success').addClass('text-danger');
            }
        });
    }, 1000);
});
</script>