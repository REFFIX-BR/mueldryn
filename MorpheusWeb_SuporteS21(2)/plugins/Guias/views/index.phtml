<h1 class="title"><?= __('Guides') ?></h1>

<ul class="breadcrumber">
    <li><a href="<?= url_to('/') ?>" data-ajax><?= __('Home') ?></a></li>
    <li class="active"><?= __('Guides') ?></li>
</ul>


<?php if (!empty($categories)): ?>
    <div class="panel">
        <div class="grid">
            <div class="grid-4">
                <ul class="panel-services">
                    <?php foreach ($categories as $category): ?>
