                        <a data-ajax href="<?= url_to('/guide/' . $guide['slug']) ?>"><?= $guide['title'] ?></a>

                        <span class="vote-container">
                            <i class="fa fa-thumbs-up vote-up"></i> (<?= $guide['up'] ?>)
                            <i class="fa fa-thumbs-down vote-down"></i> (<?= $guide['down'] ?>)
