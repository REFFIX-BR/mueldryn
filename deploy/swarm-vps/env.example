# Copie para .env na VPS: cp env.example .env

# Imagem OpenMU (custom MuEldryn)
OPENMU_IMAGE=openmu-rare:local

# Postgres — stack postgres_postgres (mesma rede reffix)
# Rode uma vez: ./tools/setup-openmu-postgres.sh /root/openmu-local.dump
DB_HOST=postgres_postgres
DB_ADMIN_USER=openmu
DB_ADMIN_PW=MuEldryn2026!

# IP que o client recebe ao escolher GameServer
RESOLVE_IP=170.80.224.11

# Traefik — rede overlay do Swarm (mesma do serviço traefik_traefik)
# VPS Soneca: reffix (docker service inspect traefik_traefik)
TRAEFIK_NETWORK=reffix

# Traefik — domínios (ajuste certresolver se o seu Traefik usar outro nome)
OPENMU_ADMIN_HOST=admin.seudominio.com
UPDATE_HOST=170.80.224.11

# Pasta na VPS com MiniUpdate/ (conteúdo de MUPegasusOldLauncher/UpdateServer)
UPDATE_ROOT=/opt/mueldryn/www
